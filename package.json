{
  "name": "strait",
  "version": "0.1.0",
  "private": true,
  "description": "Crypto-in / crypto-out USDC payment orchestrator. Members fund via on-chain USDC (Mesh); recipients receive USDC via direct wallet transfer or a custodial pay-out provider. Shadow-ledger + state-machine + outbox core from Lira-Bridge, narrowed to crypto-only.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nest build",
    "build:client": "cd client && npm run build",
    "build:all": "npm run build && npm run build:client",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "jest --config test/integration/jest.integration.config.js --runInBand",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs src client/src && node scripts/check-no-process-env.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm -- migration:run -d database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d database/data-source.ts migrations/new-migration"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.16.1",
    "dotenv": "^16.4.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "serve-static": "^1.16.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "dependency-cruiser": "^16.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@strait/contract$": "<rootDir>/../packages/contract/src/index.ts",
      "@common/(.*)": "<rootDir>/common/$1",
      "@config/(.*)": "<rootDir>/config/$1",
      "@secrets/(.*)": "<rootDir>/secrets/$1",
      "@database/(.*)": "<rootDir>/database/$1",
      "@events/(.*)": "<rootDir>/events/$1"
    }
  }
}
