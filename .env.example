NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://strait:strait@localhost:5432/strait
WEBHOOK_BASE_URL=http://localhost:3000

# --- Mesh (Path A: crypto in) ---
MESH_WEBHOOK_SECRET=dev-mesh-secret
MOCK_MESH_ENABLED=true

# --- Outbound dispatch (crypto out) ---
# Default-mock; flip to false once a real adapter is wired and verified.
MOCK_DISPATCH_ENABLED=true
MOCK_DISPATCH_SETTLE_MS=250
MOCK_DISPATCH_FAILURE_RATE=0

# ChainDispatcher (direct on-chain USDC transfer)
CHAIN_DISPATCHER_ENABLED=true
CHAIN_RPC_URL=
CHAIN_PRIVATE_KEY=                    # treasury hot wallet — production must come from Vault, never .env
CHAIN_USDC_CONTRACT_MAINNET=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
CHAIN_USDC_CONTRACT_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# CustodialDispatcher (third-party crypto pay-out provider — adapter TBD)
CUSTODIAL_DISPATCHER_ENABLED=false
CUSTODIAL_API_KEY=
CUSTODIAL_API_BASE_URL=
CUSTODIAL_WEBHOOK_SECRET=

# Whether the dispatch listener will actually call dispatch on USDC_LOCKED events.
# Keep false until adapters are sandbox-verified.
RECIPIENT_DISPATCH_ENABLED=false

# --- Member auth (magic-link JWT) ---
MEMBER_JWT_SECRET=dev-member-jwt-secret
MEMBER_MAGIC_LINK_TTL_SECONDS=600

# --- Admin auth ---
ADMIN_JWT_SECRET=dev-admin-jwt-secret

# --- Dev tools (DO NOT enable in production) ---
DEV_TOOLS_ENABLED=true
